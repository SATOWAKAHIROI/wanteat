# https://console.anthropic.com の Settings > API keys で発行したキーを設定する
# このファイルを .env にコピーして値を埋めること（.env は .gitignore 済み）
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# --- 以下は本番公開時に設定する（未設定なら開発用の既定値が使われる） ---
# JWT の署名鍵。未設定だと docker compose が起動を拒否する（必須）
#   openssl rand -base64 48
JWT_SECRET=

# DB 認証情報。未設定だと docker compose が起動を拒否する（必須）
# 既存のボリュームがある場合、値を変えると接続できなくなる（作り直しが必要）
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# HTTPS で公開する場合は true にする（false のままだと Cookie が送信されない）
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# フロントと API のサブドメインが分かれる場合のみ設定（例: .example.com）
COOKIE_DOMAIN=

# フロントの公開オリジン。カンマ区切りで複数可
CORS_ORIGINS=http://localhost:3000

# 値を設定するとアカウント登録に招待コードが必須になる（空なら誰でも登録可）
SIGNUP_INVITE_CODE=

# --- 本番（compose.prod.yaml）で使う ---
# 公開するホスト名。Caddy がこの名前で Let's Encrypt の証明書を取得する
#   ローカルで本番構成を検証するときは :80 のようにポートだけ指定する（平文 HTTP になる）
DOMAIN=

# Caddy が待ち受けるホスト側ポート。通常は変更不要
# HTTP_PORT=80
# HTTPS_PORT=443
